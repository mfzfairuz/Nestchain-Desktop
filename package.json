{
  "name": "nestchain-desktop-electron",
  "version": "0.1.0",
  "private": true,
  "description": "Nestchain ERP desktop, versi Electron untuk perbandingan dengan versi Tauri",
  "main": "main.js",
  "author": "PT Lentera Alam Nusantara",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "id.nestchain.desktop.electron",
    "productName": "Nestchain ERP Electron",
    "copyright": "PT Lentera Alam Nusantara",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "src/**/*"],
    "win": { "target": ["nsis"], "icon": "build/icon.png", "artifactName": "NestchainSetup-Electron-${version}.${ext}" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": false, "language": "1057" },
    "publish": { "provider": "github", "owner": "mfzfairuz", "repo": "Nestchain-Desktop-Electron" }
  }
}
