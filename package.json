{
  "name": "nestchain-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Aplikasi desktop Nestchain ERP untuk Windows dan Mac (Electron, data tetap di server Nestchain)",
  "main": "main.js",
  "author": "PT Lentera Alam Nusantara",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis",
    "build:mac": "electron-builder --mac",
    "pratinjau": "node pratinjau.js"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "id.nestchain.desktop",
    "productName": "Nestchain ERP",
    "copyright": "PT Lentera Alam Nusantara",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "src/**/*"],
    "win": { "target": ["nsis"], "icon": "build/icon.png", "artifactName": "NestchainSetup-${version}.${ext}", "publisherName": "PT Lentera Alam Nusantara" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": false, "language": "1057", "shortcutName": "Nestchain ERP" },
    "mac": { "target": [{ "target": "dmg", "arch": ["universal"] }, { "target": "zip", "arch": ["universal"] }], "icon": "build/icon.png", "category": "public.app-category.business", "artifactName": "Nestchain-${version}-${arch}.${ext}", "hardenedRuntime": true, "gatekeeperAssess": false },
    "dmg": { "artifactName": "Nestchain-${version}.${ext}" },
    "publish": { "provider": "github", "owner": "mfzfairuz", "repo": "Nestchain-Desktop", "releaseType": "release" }
  }
}
